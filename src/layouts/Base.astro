---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Wonderfully Made Co. | Natural beauty, wonderfully made',
  description = 'Small-batch natural beauty, starting with our signature tinted lip balm. Made by our family, for yours.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="topbar">Holiday pre-orders are now open.</div>

    <header class="wrap site-header">
      <a href="/" class="brand">
        <span class="brand-name">Wonderfully Made Co.</span>
        <span class="brand-tag">Made by our family, for yours</span>
      </a>
      <nav aria-label="Main">
        <a href="/#shop">Shop</a>
        <a href="/#soon">Coming soon</a>
        <a href="/#inside">Ingredients</a>
        <a href="/#story">Our story</a>
        <a href="/order" class="btn btn-outline cart">Order</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="wrap site-footer">
      <p class="verse">"I praise you because I am fearfully and wonderfully made."</p>
      <p class="eyebrow ref">Psalm 139:14</p>
      <p class="fine">© {new Date().getFullYear()} Wonderfully Made Co.</p>
    </footer>
  </body>
</html>

<style>
  .topbar { background: var(--green); color: var(--cream); text-align: center; font-size: 14px; padding: 10px 16px; }
  .site-header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding-top: 20px; padding-bottom: 20px; }
  .brand { text-decoration: none; display: flex; flex-direction: column; line-height: 1.1; }
  .brand-name { font-family: var(--serif); font-size: 30px; font-weight: 600; color: var(--green); }
  .brand-tag { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: #5E7055; }
  nav { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; font-size: 15px; }
  nav a:not(.btn) { text-decoration: none; }
  .cart { min-height: 44px; padding: 0 18px; }
  .site-footer { padding-top: 48px; padding-bottom: 48px; display: flex; flex-direction: column; gap: 12px; align-items: center; text-align: center; }
  .verse { margin: 0; font-family: var(--serif); font-style: italic; font-size: 22px; color: var(--green); max-width: 620px; }
  .ref { color: #5E7055; }
  .fine { margin: 8px 0 0; font-size: 13px; color: #5E7055; }
</style>
