---
import Base from '../../layouts/Base.astro';
import { signatureProducts, ingredients, allergenNote, formatPrice } from '../../data/products';

export function getStaticPaths() {
  return signatureProducts.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
---
<Base title={`${product.name} | Wonderfully Made Co.`} description={product.blurb}>
  <section class="wrap product">
    <div class="photo product-photo">{product.photo}</div>
    <div class="product-info">
      <a href="/#shop" class="back">← Back to shop</a>
      <h1>{product.name}</h1>
      <p class="price">{formatPrice(product.price)}</p>
      <p class="lead">{product.description}</p>

      <!-- TODO(payments): replace with the chosen payment provider's checkout. Not wired yet. -->
      <a href={`/order?item=${product.slug}`} class="btn btn-primary">Add to order</a>

      <div class="details">
        <h2>Ingredients</h2>
        <ul>
          {ingredients.map((i) => <li><strong>{i.name}</strong> — {i.why}</li>)}
        </ul>
        <p class="lead">{allergenNote}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .product { display: flex; flex-wrap: wrap; gap: 48px; padding-top: 40px; padding-bottom: 80px; }
  .product-photo { flex: 1 1 380px; min-height: 460px; border-radius: 24px; background: var(--sage); color: var(--ink); }
  .product-info { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .back { font-size: 14px; }
  h1 { font-size: clamp(40px, 6vw, 56px); }
  .price { margin: 0; font-size: 20px; font-weight: 600; }
  .details { margin-top: 24px; border-top: 1px solid var(--line); padding-top: 24px; width: 100%; }
  .details h2 { font-size: 28px; margin-bottom: 8px; }
  ul { padding-left: 18px; line-height: 1.8; }
</style>
